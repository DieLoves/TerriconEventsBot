BASE_URL=https://example.com/api/events
# Optional; defaults to the sibling eventsByStage endpoint of BASE_URL.
# STAGE_URL=https://example.com/api/eventsByStage
TELEGRAM_BOT_TOKEN=replace-me
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MONTHLY_BUDGET_USD=5
# Free tier: actual cost is zero; token usage is still recorded.
GROQ_INPUT_PRICE_PER_MILLION_USD=0
GROQ_OUTPUT_PRICE_PER_MILLION_USD=0
GROQ_TIMEOUT_SECONDS=30
# Shared rolling quotas for classification AND translation; tune against account Limits.
# Defaults reserve 20% of published Free capacity for other organization workloads.
GROQ_RPM=24
GROQ_RPD=800
GROQ_TPM=6400
GROQ_TPD=160000
# Keep identical across processes sharing this organization and database.
GROQ_QUOTA_SCOPE=groq:default
DATABASE_URL=postgresql+asyncpg://terricon:replace-me@db:5432/terricon
POSTGRES_PASSWORD=change-me-local
ADMIN_TELEGRAM_IDS=123456789
ADMIN_CHAT_ID=123456789
ACCESS_MODE=allowlist
ALLOWED_TELEGRAM_IDS=123456789
APP_TIMEZONE=Asia/Almaty
SYNC_INTERVAL_HOURS=6
SYNC_MAX_RETRIES=3
# Alert the admin when eventsByStage is replaced by getAllEvents this long.
SOURCE_FALLBACK_ALERT_HOURS=24
EVENTS_PAGE_SIZE=5
QUIET_HOURS_START=22:00
QUIET_HOURS_END=09:00
FEEDBACK_RETENTION_DAYS=90
LOG_LEVEL=INFO
